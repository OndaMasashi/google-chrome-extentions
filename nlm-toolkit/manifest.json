{
  "manifest_version": 3,
  "name": "Gemini Notebook Toolkit",
  "version": "2.1.0",
  "description": "Gemini Notebook（旧NotebookLM）のノートブック一覧に作成日順ソート・タイトル検索機能を追加します",
  "content_scripts": [
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
